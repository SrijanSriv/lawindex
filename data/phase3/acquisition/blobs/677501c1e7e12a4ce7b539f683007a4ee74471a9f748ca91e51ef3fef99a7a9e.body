                "dc.identifier.next_section" : [ {
                  "value" : "81.Act to have overriding effect.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
                  "value" : "107",
                  "language" : null,
