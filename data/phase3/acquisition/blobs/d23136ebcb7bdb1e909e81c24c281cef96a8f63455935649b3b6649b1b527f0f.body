    "dc.identifier.preamble_description" : [ {
      "value" : "<center style=\"font-size: 17px;\">THE FOREIGN CONTRIBUTION (REGULATION) ACT, 2010</center> <center style=\"font-size: 16px;\">ACT NO. 42 OF 2010</center> <p style=\"text-align:right;\">[26th September, 2010.]</p> An Act to consolidate the law to regulate the acceptance and utilisation of foreign contribution or foreign hospitality by certain individuals or associations or companies and to prohibit acceptance and utilisation of foreign contribution or foreign hospitality for any activities detrimental to the national interest and for matters connected therewith or incidental thereto.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span>BE it enacted by Parliament in the Sixty-first Year of the Republic of India as follows:--",
      "language" : null,
      "authority" : null,
      "confidence" : -1,
      "place" : 0
    } ],
