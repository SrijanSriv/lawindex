    "dc.identifier.preamble_description" : [ {
      "value" : "<center style=\"font-size: 17px;\">THE MERCHANT SHIPPING ACT, 2025 <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> ACT NO. 24 OF 2025</center><br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <p style=\"text-align:right;\">[18<i>th August,</i> 2025.]</p> <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> An Act to consolidate and amend the law relating to merchant shipping to ensure compliance with India's obligation under the maritime treaties and international instruments to which India is a party and also to ensure the development of Indian shipping and efficient maintenance of Indian mercantile marine in a manner best suited to serve the national interest and for matters connected therewith or incidental thereto.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span>BE it enacted by Parliament in the Seventy-sixth Year of the Republic of India as follows:--- <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
      "language" : null,
      "authority" : null,
      "confidence" : -1,
      "place" : 0
    } ],
