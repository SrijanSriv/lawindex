                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>This Part shall apply to every establishment in which ten or more interState migrant workers are employed or were employed on any day of the preceding twelve months. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
