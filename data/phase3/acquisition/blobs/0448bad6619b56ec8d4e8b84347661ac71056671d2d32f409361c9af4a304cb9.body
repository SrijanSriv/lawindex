                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_id" : [ {
                  "value" : "101678",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "10",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>(1) Where at any place in an establishment, an accident occurs which causes death, or which causes any bodily injury by reason of which the person injured is prevented from working for a period of forty-eight hours or more immediately following the accident or which is of such nature as may be prescribed by the appropriate Government, then,---<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span><span style=\"margin-left: 15px;\"></span>(a) employer or owner or agent or manager referred to in section 67 of such establishment if it is mine; or<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span><span style=\"margin-left: 15px;\"></span>(b) employer or manager in relation to such establishment if it is factory or relates to dock work; or<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span><span style=\"margin-left: 15px;\"></span>(c) the employer of a plantation or an establishment relating to building or other construction or any other establishment,<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> shall send notice thereof to such authorities, in such manner and within such time, as may be prescribed by the appropriate Government.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span>(2) Where a notice given under sub-section (<i>1</i>) relates to an accident causing death in a plantation or an establishment relating to building or other construction work or any other establishment, the authority to whom the notice is sent shall make an inquiry into the occurrence within two months of the receipt of the notice or if there is no such authority, the Chief Inspector-cum-Facilitator shall cause the Inspectorcum-Facilitator to make an inquiry within the said period.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
