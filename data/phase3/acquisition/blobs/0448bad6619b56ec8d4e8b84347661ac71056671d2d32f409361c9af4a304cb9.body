                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "43",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>Women shall be entitled to be employed in all establishments for all types of work under this Code and they may also be employed, with their consent before 6 a.m. and beyond 7 p.m. subject to such conditions relating to safety, holidays and working hours or any other condition to be observed by the employer as may be prescribed by the appropriate Government.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
