                } ],
                "dc.title" : [ {
                  "value" : "Special powers of Inspector-cum-Facilitator in respect of factory, mines, dock work and building or other construction work.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ]
