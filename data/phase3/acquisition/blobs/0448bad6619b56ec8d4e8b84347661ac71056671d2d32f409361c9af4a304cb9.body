                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>The maximum permissible limits of exposure of chemical and toxic substances in manufacturing process in any factory shall be of the value as may be prescribed by the State Government. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
