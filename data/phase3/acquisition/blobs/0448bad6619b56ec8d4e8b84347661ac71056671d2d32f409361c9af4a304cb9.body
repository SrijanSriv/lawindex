                } ],
                "dc.identifier.repealed" : [ {
                  "value" : "false",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_id" : [ {
                  "value" : "101716",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "49",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>The contractor shall not charge directly or indirectly, in whole or in part, any fee or commission from the contract labour.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
