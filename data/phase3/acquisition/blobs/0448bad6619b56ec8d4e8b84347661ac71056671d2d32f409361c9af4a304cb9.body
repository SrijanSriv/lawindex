                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>Any person aggrieved by the decision of the authority referred to in sub-section (<i>1</i>) of section 119 refusing to grant or renew a licence, or cancelling or suspending a licence, relating to this Part may, within such time and on payment of such fees as may be prescribed, appeal to the appellate authority referred to in sub-section (<i>6</i>) of section 119, and such authority may by order confirm, modify or reverse any order refusing to grant or renew a licence, or cancelling or suspending a licence, relating to this Part.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
