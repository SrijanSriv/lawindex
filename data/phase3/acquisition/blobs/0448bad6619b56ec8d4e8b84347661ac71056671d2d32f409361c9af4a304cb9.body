                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "54",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>Where any principal employer of an establishment is employing contract labour through a contractor who is required to obtain a licence under this Part, but he has not obtained such licence, then, such employment shall be deemed to be in contravention of the provision of this Code.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
