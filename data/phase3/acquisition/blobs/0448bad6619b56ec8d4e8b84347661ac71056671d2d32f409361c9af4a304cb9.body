                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>The appropriate Government may, in the case of an emergency, direct, by notification, that subject to such conditions and restrictions, if any, and for such period, as may be specified in the notification, all or any of the provisions of this Code or the rules made thereunder shall not apply to any establishment or class of establishments or any class of contractors.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
