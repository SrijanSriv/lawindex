                } ],
                "dc.identifier.repealed" : [ {
                  "value" : "false",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_id" : [ {
                  "value" : "101754",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "87",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>(1) Where the Central Government is satisfied that no standards of safety have been prescribed in respect of a hazardous process or class of hazardous processes, or where the standards so prescribed are inadequate, it may direct the Directorate General Occupational Safety and Health formerly known as the Directorate General of Factory Advice Service and Labour Institutes or any Institution authorised in matters relating to standards of safety in hazardous processes, to lay down emergency standards for enforcement of suitable standards in respect of such hazardous processes.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span>(2) The emergency standards laid down under sub-section (<i>1</i>) shall, until they are incorporated in the rules made under this Code, be enforceable and have the same effect as if they had been incorporated in the rules made under this Code.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.state_id" : [ {
                  "value" : "1",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
