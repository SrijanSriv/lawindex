                  "place" : 0
                } ],
                "dc.identifier.section_id" : [ {
                  "value" : "101718",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "51",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>(1) If the authority referred to in sub-section (<i>1</i>) of section 119 is satisfied, either on a reference made to him in this behalf or otherwise, that--- <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span><span style=\"margin-left: 15px;\"></span>(a) a licence granted for the purposes of this Part has been obtained by misrepresentation or suppression of any material fact, or<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span><span style=\"margin-left: 15px;\"></span>(b) the holder of a licence has, failed to comply with the conditions subject to which the licence has been granted or has contravened any of the provisions of this Part or the rules made thereunder, then,<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> without prejudice to any other penalty to which the contractor may be liable under this Code, the authority referred to in sub-section (<i>1</i>) of section 119 may, after giving the contractor an opportunity of showing cause, revoke or suspend the licence in accordance with the procedure as may be prescribed by the Central Government.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span>(2) Subject to any rules that may be made in this behalf, the authority referred to in sub-section (<i>1</i>) of section 119 may amend a licence granted for the purposes of this Part.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
