                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>The District Magistrate shall, within the local limits of his jurisdiction, exercise such powers and duties of the Inspector-cum-Facilitator in respect of mines as may be prescribed by the Central Government.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
