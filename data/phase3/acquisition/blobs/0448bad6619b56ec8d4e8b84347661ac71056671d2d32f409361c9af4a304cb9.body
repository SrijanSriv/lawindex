                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>Every employer of an establishment shall afford the Chief Inspector-cum-Facilitator and every Inspector-cum-Facilitator having jurisdiction or every person authorised by the Chief Inspector-cum-Facilitator all reasonable facilities for making any entry, inspection, survey, measurement, examination or inquiry under this Code.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
