                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "73",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>If any question arises as to whether any excavation or working or premises in or adjacent to and belonging to a mine, on which any process ancillary to the getting, dressing or preparation for sale of minerals or of coke is being carried on in a mine within the meaning of this Code, the Central Government may decide the question, and a certificate signed by a Secretary to the Government of India in the Ministry of Labour and Employment shall be conclusive proof thereof.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
