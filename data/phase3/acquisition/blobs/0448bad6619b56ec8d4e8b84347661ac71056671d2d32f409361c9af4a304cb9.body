              "name" : "Special powers of Inspector-cum-Facilitator in respect of factory, mines, dock work and building or other construction work.",
              "handle" : "123456789/512417",
              "metadata" : {
                "dc.date.accessioned" : [ {
                  "value" : "2026-07-10T21:52:34Z",
                  "language" : null,
