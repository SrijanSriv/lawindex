                "dc.identifier.next_section" : [ {
                  "value" : "39A.Certain provisions to apply in case of broadcast reproduction right and performer’s.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
                  "value" : "53",
                  "language" : null,
