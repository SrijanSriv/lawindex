                "dc.identifier.section_number" : [ {
                  "value" : "68A",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span><b><sup>1</sup>[68A. Penalty for contravention of section 52A.</b>-- Any person who publishes a <sup>2</sup>[sound recording] or a video film in contravention of the provisions of section 52A shall be punishable with imprisonment which may extend to three years and shall also be liable to fine.]<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
