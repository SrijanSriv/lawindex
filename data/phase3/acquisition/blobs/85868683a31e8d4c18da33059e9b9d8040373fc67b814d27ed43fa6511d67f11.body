                "dc.identifier.section_footnote" : [ {
                  "value" : "<sup>1</sup>. Subs. by s. 8, <i>ibid</i>., for \"one year, or with fine, or with both\" (w.e.f. 8-10-1994).<br/><hr style=\"border: none; margin-bottom: 3px; margin-top: 0;\"/>",
