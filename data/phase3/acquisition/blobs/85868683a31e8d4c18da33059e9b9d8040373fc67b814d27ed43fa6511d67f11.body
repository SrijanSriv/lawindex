                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>There shall be kept at the Copyright Office a register in the prescribed form to be called the Register of Copyrights in which may be entered the names or titles of works and the names and addresses of authors, publishers and owners of copyright and such other particulars as may be prescribed.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
