                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "10",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span><span style=\"margin-left: 15px;\"></span>(1) The Central Government shall appoint a Registrar of Copyrights and may appoint one or more Deputy Registrars of Copyrights.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span><span style=\"margin-left: 15px;\"></span> (2) A Deputy Registrar of Copyrights shall discharge under the superintendence and direction of the Registrar of Copyrights such functions of the Registrar under this Act as the Registrar may, from time to time, assign to him; and any reference in this Act to the Registrar of Copyrights shall include a reference to a Deputy Registrar of Copyrights when so discharging any such functions.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
