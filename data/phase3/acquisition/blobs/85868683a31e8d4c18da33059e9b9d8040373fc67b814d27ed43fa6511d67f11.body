                "dc.identifier.next_section" : [ {
                  "value" : "42.Power to restrict rights in works of foreign authors first published in India.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
                  "value" : "57",
                  "language" : null,
