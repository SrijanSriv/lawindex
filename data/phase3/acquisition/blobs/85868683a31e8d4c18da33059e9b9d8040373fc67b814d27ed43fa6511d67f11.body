                "dc.identifier.section_footnote" : [ {
                  "value" : "<sup>1</sup>. Ins. by Act 65 of 1984, s. 9 (w.e.f. 8-10-1984).<br/><hr style=\"border: none; margin-bottom: 3px; margin-top: 0;\"/> <sup>2</sup>. Subs. by Act 38 of 1994, s. 2, for \"record\" (w.e.f. 10-5-1995)<br/><hr style=\"border: none; margin-bottom: 3px; margin-top: 0;\"/>",
                  "language" : null,
