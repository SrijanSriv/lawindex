                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>Any person who knowingly makes, or has in his possession, any plate for the purpose of making infringing copies of any work in which copyright subsists shall be punishable with imprisonment which may extend to <sup>1</sup>[two years and shall also be liable to fine.]<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
