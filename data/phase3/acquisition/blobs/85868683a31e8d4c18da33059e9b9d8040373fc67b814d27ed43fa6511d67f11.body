                "dc.identifier.section_footnote" : [ {
                  "value" : "<sup>1</sup>. Subs. by Act 33 of 2021, s.10, for “Appellate Board” (w.e.f. 4-4-2021).<br/><hr style=\"border: none; margin-bottom: 3px; margin-top: 0;\"/>",
