                "dc.identifier.repealed" : [ {
                  "value" : "false",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_footnote" : [ {
                  "value" : "<sup>1</sup> Subs. by Act 27 of 2012, s. 28, for section 39A (w.e.f. 21-6-2012)<br/><hr style=\"border: none; margin-bottom: 3px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_id" : [ {
                  "value" : "14556",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "39A",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span><sup>1</sup>[<b>39A. Certain provisions to apply in case of broadcast reproduction right and performer’s rights.</b>-- Sections 18, 19, 30, 30A, 33, 33A, 34, 35, 36, 53, 55, 58, 63, 64, 65, 65A, 65B and 66 shall, with necessary adaptations and modifications, apply in relation to the broadcast reproduction right in any broadcast and the performer's right in any performance as they apply in relation to copyright in a work:<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> Provided that where copyright to performers right subsists in respect of any work or performance that has been broadcast, no licence to reproduce such broadcast, shall be given without the consent of the owner of rights or performer, as the case may be, or both of them:<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> Provided further that the broadcast reproduction right or performers right shall not subsist in any broadcast or performance if that broadcast or performance is an infringement of the copyright in any work.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> (2) The broadcast reproduction right or the performers right shall not affect the separate copyright in any work in respect of which, the broadcast or the performance, as the case may be, is made.]<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.state_id" : [ {
                  "value" : "1",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
