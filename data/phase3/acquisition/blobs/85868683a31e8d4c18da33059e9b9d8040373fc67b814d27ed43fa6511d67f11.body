                "dc.identifier.next_section" : [ {
                  "value" : "39.Acts not infringing broadcast reproduction right or performer’s right.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
                  "value" : "52",
                  "language" : null,
