                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>Every order made by the Central Government under this Chapter shall, as soon as may be after it is made, be laid before both Houses of Parliament and shall be subject to such modifications as Parliament may make during the session in which it is so laid or the session immediately following.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
