                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span><span style=\"margin-left: 15px;\"></span>(1) There shall be established for the purposes of this Act an office to be called the Copyright Office.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> <span style=\"margin-left: 15px;\"></span>(2) The Copyright Office shall be under the immediate control of the Registrar of Copyrights who shall act under the superintendence and direction of the Central Government.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> <span style=\"margin-left: 15px;\"></span>(3) There shall be a seal for the Copyright Office.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span><br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
