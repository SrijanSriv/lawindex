                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>Where, in the case of an unpublished work, the making of the work is extended over a considerable period, the author of the work shall, for the purposes of this Act, be deemed to be a citizen of, or domiciled in, that country of which he was a citizen or wherein he was domiciled during any substantial part of that period.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
