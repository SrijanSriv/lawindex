                "dc.identifier.next_section" : [ {
                  "value" : "61.Owner of copyright to be party to the proceeding.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
                  "value" : "81",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.page_from" : [ {
                  "value" : "0",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.page_number" : [ {
                  "value" : "39",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.page_to" : [ {
                  "value" : "0",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.repealed" : [ {
                  "value" : "false",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_footnote" : [ {
                  "value" : "<sup>1</sup> . Subs. by s. 22, <i>ibid</i>., for \" in section 42 the Specific Relief Act, 1877 (1 of 1977)\" (w.e.f. 9-8-1984).<br/><hr style=\"border: none; margin-bottom: 3px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_id" : [ {
                  "value" : "14583",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "60",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>Where any person claiming to be the owner of copyright in any work, by circulars, advertisements or otherwise, threatens any other person with any legal proceedings or liability in respect of an alleged infringement of the copyright any person aggrieved thereby may, notwithstanding anything contained <sup>1</sup>[in section 34 of the Specific Relief Act, 1963 (47 of 1963)], institute a declaratory suit that the alleged infringement to which the threats related was not in fact an infringement of any legal rights of the person making such threats and may in any such suit--<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> (a) obtain an injunction against the continuance of such threats; and<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> (b) recover such damages, if any, as he has sustained by reason of such threats:<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> Provided that this section does not apply if the person making such threats, with due diligence, commences and prosecutes an action for infringement of the copyright claimed by him. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.state_id" : [ {
                  "value" : "1",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.state_name" : [ {
                  "value" : "CENTRAL",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
