                "dc.identifier.section_footnote" : [ {
                  "value" : "<sup>1</sup>. Subs. by Act 38 of 1994, s. 11, for Chapter VII (w.e.f. 10-5-1995).<br/><hr style=\"border: none; margin-bottom: 3px; margin-top: 0;\"/> <sup>2</sup>. Subs. by Act 27 of 2012, s. 21, for \"owner of rights\" (w.e.f. 21-6-2012)<br/><hr style=\"border: none; margin-bottom: 3px; margin-top: 0;\"/>",
