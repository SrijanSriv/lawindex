                } ],
                "dc.identifier.page_to" : [ {
                  "value" : "0",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.repealed" : [ {
                  "value" : "false",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_footnote" : [ {
                  "value" : "<sup>1</sup>. Subs. by Act 38 of 1994, s. 9, for section 19A (w.e.f. 10-5-1995). <br/><hr style=\"border: none; margin-bottom: 3px; margin-top: 0;\"/> <sup>2</sup>. Subs. by Act 33 of 2021, s.21, for “Appellate Board” (w.e.f. 4-4-2021). <br/><hr style=\"border: none; margin-bottom: 3px; margin-top: 0;\"/> <sup>3</sup>. Subs. by Act 27 of 2012, s. 10, for Provided further that (w.e.f. 21-6-2012). <br/><hr style=\"border: none; margin-bottom: 3px; margin-top: 0;\"/> <sup>4</sup>. Ins. by Act 27 of 2012, s. 10 (w.e.f. 21-6-2012). <br/><hr style=\"border: none; margin-bottom: 3px; margin-top: 0;\"/> <br/><hr style=\"border: none; margin-bottom: 3px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_id" : [ {
                  "value" : "14522",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "19A",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span><sup>1</sup><b>[19A. Disputes with respect to assignment of copyright.--</b>(1) If an assignee fails to make sufficient exercise of the rights assigned to him, and such failure is not attributable to any act or omission of the assignor, then, the <sup>2</sup>[ Commercial Court] may, on receipt of a complaint from the assignor and after holding such inquiry as it may deem necessary, revoke such assignment. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> (2) If any dispute arises with respect to the assignment of any copyright, the <sup>2</sup>[Commercial Court] may, on receipt of a complaint from the aggrieved party and after holding such inquiry as it considers necessary, pass such order as it may deem fit including an order for the recovery of any royalty payable: <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> Provided that the <sup>2</sup>[Commercial Court] shall not pass any order under this sub-section to revoke the assignment unless it is satisfied that the terms of assignment are harsh to the assignor in case the assignor is also the author: <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> <sup>3</sup>[Provided further that, pending the disposal of an application for revocation of assignment under this sub-section, the <sup>2</sup>[Commercial Court] may pass such order, as it deems fit regarding implementation of the terms and conditions of assignment including any consideration to be paid for the enjoyment of the rights assigned:---<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> Provided also that,] no order of revocation of assignment under this sub-section, shall be made within a period of five years from the date of such assignment.] <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> <sup>4</sup>[(3) Every complaint received under sub-section (2) shall be dealt with by the <sup>2</sup>[Commercial Court] as far as possible and efforts shall be made to pass the final order in the matter within a period of six months from the date of receipt of the complaint and any delay in compliance of the same, the <sup>2</sup>[Commercial Court] shall record the reasons thereof.] <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span><br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.state_id" : [ {
                  "value" : "1",
