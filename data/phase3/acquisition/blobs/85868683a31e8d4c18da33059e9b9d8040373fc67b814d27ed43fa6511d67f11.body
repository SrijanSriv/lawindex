                "dc.identifier.section_footnote" : [ {
                  "value" : "<sup>1</sup>. Ins. by s. 38, <i>ibid</i>. (w.e.f. 21-6-2012).<br/><hr style=\"border: none; margin-bottom: 3px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
