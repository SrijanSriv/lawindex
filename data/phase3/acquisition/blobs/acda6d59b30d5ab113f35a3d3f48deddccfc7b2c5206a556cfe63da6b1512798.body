                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span><b><sup>1</sup>[42A. Confidentiality of information.</b>-- Notwithstanding anything contained by any other law for the time being in force, the arbitrator, the arbitral institution and the parties to the arbitration agreement shall maintain confidentially of all arbitral proceedings except award where its disclosure is necessary for the purpose of implementation and enforcement of award.]<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
