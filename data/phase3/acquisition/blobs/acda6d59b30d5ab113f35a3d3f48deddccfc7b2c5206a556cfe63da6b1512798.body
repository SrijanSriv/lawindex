                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>Subject to this Part an arbitral award shall be final and binding on the parties and persons claiming under them respectively.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
