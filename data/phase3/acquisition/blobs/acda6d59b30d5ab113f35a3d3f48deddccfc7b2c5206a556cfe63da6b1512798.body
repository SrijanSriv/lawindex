                "dc.identifier.next_section" : [ {
                  "value" : "26.Expert appointed by arbitral tribunal.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
                  "value" : "26",
                  "language" : null,
