                "dc.identifier.next_section" : [ {
                  "value" : "25.Default of a party.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
                  "value" : "25",
                  "language" : null,
