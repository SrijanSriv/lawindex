                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>The parties shall not initiate, during the conciliation proceedings, any arbitral or judicial proceedings in respect of a dispute that is the subject-matter of the conciliation proceedings except that a party may initiate arbitral or judicial proceedings where, in his opinion, such proceedings are necessary for preserving his rights.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
