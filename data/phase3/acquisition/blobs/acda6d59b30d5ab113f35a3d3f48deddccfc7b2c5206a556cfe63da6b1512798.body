                "dc.identifier.section_footnote" : [ {
                  "value" : "<sup>1</sup>. Ins. by Act 33 of 2019, s. 9 (w.e.f. 30-8-2019).<br/><hr style=\"border: none; margin-bottom: 3px; margin-top: 0;\"/>",
                  "language" : null,
