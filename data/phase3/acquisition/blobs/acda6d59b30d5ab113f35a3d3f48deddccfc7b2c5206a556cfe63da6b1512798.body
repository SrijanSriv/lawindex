                "dc.identifier.next_section" : [ {
                  "value" : "41.Provisions in case of insolvency.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
