                "dc.identifier.next_section" : [ {
                  "value" : "81.Admissibility of evidence in other proceedings.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
