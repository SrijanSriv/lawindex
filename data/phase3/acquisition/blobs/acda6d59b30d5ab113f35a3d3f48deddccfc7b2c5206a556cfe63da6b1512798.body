                "dc.identifier.next_section" : [ {
                  "value" : "32.Termination of proceedings.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
                  "value" : "35",
