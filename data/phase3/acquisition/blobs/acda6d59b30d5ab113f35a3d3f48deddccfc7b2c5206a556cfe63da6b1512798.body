                "dc.identifier.next_section" : [ {
                  "value" : "4.Waiver of right to object.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
