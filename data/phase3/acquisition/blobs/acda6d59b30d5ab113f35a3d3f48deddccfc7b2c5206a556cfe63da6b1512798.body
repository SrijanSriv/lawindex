                "dc.identifier.next_section" : [ {
                  "value" : "82.Power of High Court to make rules.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
                  "value" : "100",
                  "language" : null,
