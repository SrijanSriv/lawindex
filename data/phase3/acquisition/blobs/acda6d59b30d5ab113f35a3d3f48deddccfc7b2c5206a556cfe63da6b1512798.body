                "dc.identifier.next_section" : [ {
                  "value" : "16.Competence of arbitral tribunal to rule on its jurisdiction.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
