                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>The conciliator is not bound by the Code of Civil Procedure, 1908 (5 of 1908) or the Indian Evidence Act, 1872 (1 of 1872).<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
