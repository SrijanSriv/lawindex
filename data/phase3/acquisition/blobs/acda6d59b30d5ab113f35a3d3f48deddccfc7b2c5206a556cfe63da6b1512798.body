                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>The parties shall be treated with equality and each party shall be given a full opportunity to present his case. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
