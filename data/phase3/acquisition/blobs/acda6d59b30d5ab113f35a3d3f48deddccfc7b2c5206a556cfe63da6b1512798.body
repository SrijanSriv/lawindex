                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "42B",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span><b><sup>1</sup>[42B. Protection of action taken in good faith.</b>-- No suit or other legal proceedings shall lie against the arbitrator for anything which is in good faith done or intended to be done under this Act or the rules or regulations made thereunder.] <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
