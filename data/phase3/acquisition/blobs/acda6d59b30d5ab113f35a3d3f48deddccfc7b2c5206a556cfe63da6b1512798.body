                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "49",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>Where the Court is satisfied that the foreign award is enforceable under this Chapter, the award shall be deemed to be a decree of that Court.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
