                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "29",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>(1) Unless otherwise agreed by the parties, in arbitral proceedings with more than one arbitrator, any decision of the arbitral tribunal shall be made by a majority of all its members.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> (2) Notwithstanding sub-section <i>(1)</i>, if authorised by the parties or all the members of the arbitral tribunal, questions of procedure may be decided by the presiding arbitrator.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
