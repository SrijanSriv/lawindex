                "dc.identifier.next_section" : [ {
                  "value" : "51.Saving.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
                  "value" : "69",
                  "language" : null,
