                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "68",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>In order to facilitate the conduct of the conciliation proceedings, the parties, or the conciliator with the consent of the parties, may arrange for administrative assistance by a suitable institution or person. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
