                "dc.identifier.next_section" : [ {
                  "value" : "3.Receipt of written communications.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
                  "value" : "2",
                  "language" : null,
