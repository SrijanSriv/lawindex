                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.page_to" : [ {
                  "value" : "0",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.repealed" : [ {
                  "value" : "false",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_id" : [ {
                  "value" : "24542",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "38",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>(1) The arbitral tribunal may fix the amount of the deposit or supplementary deposit, as the case may be, as an advance for the costs referred to in sub-section <i>(8)</i> of section 31, which it expects will be incurred in respect of the claim submitted to it:<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> Provided that where, apart from the claim, a counter-claim has been submitted to the arbitral tribunal, it may fix separate amount of deposit for the claim and counter-claim.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> (2) The deposit referred to in sub-section <i>(1)</i> shall be payable in equal shares by the parties: Provided that where one party fails to pay his share of the deposit, the other party may pay that share:<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> Provided further that where the other party also does not pay the aforesaid share in respect of the claim or the counter-claim, the arbitral tribunal may suspend or terminate the arbitral proceedings in respect of such claim or counter-claim, as the case may be.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> (3) Upon termination of the arbitral proceedings, the arbitral tribunal shall render an accounting to the parties of the deposits received and shall return any unexpended balance to the party or parties, as the case may be. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.state_id" : [ {
                  "value" : "1",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
