          "_embedded" : {
            "indexableObject" : {
              "id" : "769e081c-f8d1-4987-ab07-b93a11ae53ad",
              "uuid" : "769e081c-f8d1-4987-ab07-b93a11ae53ad",
              "name" : "The Real Estate (Regulation and Development) Act, 2016.",
              "handle" : "123456789/496051",
              "metadata" : {
