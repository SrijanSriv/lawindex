                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.date.enact_date" : [ {
                  "value" : "2016-03-25",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.date.enforcement_date" : [ {
                  "value" : "01-05-2016",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.date.issued" : [ {
                  "value" : "2016-03-25",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.date.last_modified" : [ {
                  "value" : "2019-12-02",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.description.abstract" : [ {
                  "value" : "Summary of the Real Estate (Regulation and Development) Act, 2016 \nKey Provisions \n1.\tRegulatory Oversight and Enforcement: - Suspension of Real Estate Agents: Registrations may be suspended for a fitting period after providing an opportunity to be heard.\n•\tPenalties for Non-Compliance (Emphasized from New Context):\n•\tPromoters:\n•\tUp to 10% of the project's estimated cost for non-registration.\n•\tUp to 3 years imprisonment or an additional 10% for continued violation.\n•\tDaily penalties for non-compliance with orders, calculated based on the project's cost as determined by the Authority.\n•\tReal Estate Agents:\n•\tDaily penalties up to 5% of the plot/apartment/building cost for the facilitated sale/purchase.\n•\tUp to 1 year imprisonment for non-compliance with orders.\n•\tAllottees:\n•\tDaily penalties for non-compliance with orders, cumulatively up to 5% of the cost as determined by the Authority.\n2.\tFunctions and Responsibilities: - Real Estate Agents:\n•\tProhibited Practices: Misrepresentation, unauthorized advertisements.\n•\tMandatory Practices: Transparency, record-keeping.\n•\tSector Development Recommendations:\n•\tProtection of stakeholders' interests.\n•\tStreamlined, time-bound project approvals.\n•\tRobust grievance mechanisms.\n•\tEncouragement of sustainable, affordable housing.\n•\tDigitization of land records for conclusive titles.\n3.\tGovernance and Oversight\n•\tDue Process for Regulatory Actions: Emphasis on providing a hearing before suspension/revocation of registrations.\n•\tAuthority and Appellate Tribunal Powers: Issuing binding directions, imposing penalties, and ensuring compliance.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.act_id" : [ {
                  "value" : "AC_CEN_17_19_00033_201616_1517807328405",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.act_number" : [ {
                  "value" : "16",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.collection" : [ {
                  "value" : "ACT",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.givenid" : [ {
                  "value" : "201616",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.ministry_id" : [ {
                  "value" : "17",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.ministry_name" : [ {
                  "value" : "Ministry of Housing and Urban Affairs",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.notification_no" : [ {
                  "value" : "1st May, 2016, vide notification No. S.O. 1544(E), (Except ss. 3 to 19, 40, 59 to 70, 79 & 80) dated 26th April, 2016, see Gazette of India, Extraordinary, Part II, sec. 3(ii).",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.preamble_description" : [ {
                  "value" : "<center style=\"font-size: 17px;\">THE REAL ESTATE (REGULATION AND DEVELOPMENT) ACT, 2016</center> <center style=\"font-size: 16px;\">ACT NO. 16 OF 2016</center> <p style=\"text-align:right;\">[25<i>th March,</i> 2016.]</p> An Act to establish the Real Estate Regulatory Authority for regulation and promotion of the real estate sector and to ensure sale of plot, apartment or building, as the case may be, or sale of real estate project, in an efficient and transparent manner and to protect the interest of consumers in the real estate sector and to establish an adjudicating mechanism for speedy dispute redressal and also to establish the Appellate Tribunal to hear appeals from the decisions, directions or orders of the Real Estate Regulatory Authority and the adjudicating officer and for matters connected therewith or incidental thereto.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span>BE it enacted by Parliament in the Sixty-seventh Year of the Republic of India as follows:---",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.refact" : [ {
                  "value" : "0",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
