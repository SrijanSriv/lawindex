                } ],
                "dc.date.issued" : [ {
                  "value" : "2016-12-27",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.date.last_modified" : [ {
                  "value" : "2020-04-06",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.description.abstract" : [ {
                  "value" : "Summary of the Rights of Persons with Disabilities Act, 2016\n Core Objectives:\n 1. Alignment with UN Convention: Implement the UN Convention on the Rights of Persons with Disabilities. \n2. Rights & Equality: Ensure equality, dignity, and rights of persons with disabilities across various sectors. \nKey Rights and Provisions:\n 1. Equality & Non-Discrimination:\n•\tProhibition: Discrimination against persons with disabilities prohibited.\n2.\tProtection: - Against Abuse/Exploitation: Safeguards against cruelty, torture, and exploitation.\n3.\tAccessibility: - Mandate: Accessibility in physical environment, transport, ICT, and media.\n•\tNew Context Relevance: Especially pertinent for vehicles and personal mobility assistance to ensure inclusive access.\n4.\tEducation: - Inclusive Education: Right to inclusive education, vocational training, and adult education.\n5.\tEmployment: - Promotion: Vocational training, non-discrimination, and equal opportunity policy.\n\n6.\tSocial Security & Health:\n•\tProvisions: Social security, healthcare, insurance, and rehabilitation services.\n7.\tBenchmark Disabilities: - Special Provisions: Free education, higher education reservations, and employment incentives.\n8.\tOffences & Penalties:\n•\tPunishments: For fraud, abuse, and non-compliance.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.act_id" : [ {
                  "value" : "AC_CEN_25_54_00002_201649_1517807328299",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.act_number" : [ {
                  "value" : "49",
