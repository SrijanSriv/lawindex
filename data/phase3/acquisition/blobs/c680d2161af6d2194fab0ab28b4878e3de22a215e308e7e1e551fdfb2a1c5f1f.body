                "dc.identifier.next_section" : [ {
                  "value" : "12.Environmental laboratories.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
