                "dc.identifier.next_section" : [ {
                  "value" : "18.Protection of action taken in good faith.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
