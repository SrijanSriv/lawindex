                "dc.identifier.section_number" : [ {
                  "value" : "23",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>Without prejudice to the provisions of sub-section <i>(3)</i> of section 3, the Central Government may, by notification in the Official Gazette, delegate, subject to such conditions and limitations as may be specified in the notification, such of its powers and functions under this Act [except the power to constitute an authority under sub-section <i>(3)</i> of section 3 and to make rules under section 25] as it may deem necessary or expedient, to any officer, State Government or other authority.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
