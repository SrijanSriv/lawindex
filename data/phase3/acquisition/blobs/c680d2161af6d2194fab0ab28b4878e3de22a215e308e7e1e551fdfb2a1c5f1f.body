                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_footnote" : [ {
                  "value" : "<sup>1</sup>. Subs. by Act 18 of 2023, s. 2 and Schedule, for sections 15 to 17 (w.e.f. 1-4-2024). <br/><hr style=\"border: none; margin-bottom: 3px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_id" : [ {
                  "value" : "89177",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "15D",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span><span style=\"margin-left: 15px;\"></span><sup>1</sup><b>[15D. Appeal</b>--(1) Whoever aggrieved by the order, passed by the adjudicating officer under this Act may prefer an appeal to the National Green Tribunal established under section 3 of the National Green Tribunal Act, 2010 (19 of 2010).<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span>(2) Every appeal under sub-section (1) shall be filed within sixty days from the date on which the copy of the order made by the adjudicating officer is received by the aggrieved person. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span>(3) The Tribunal may, after giving the parties to the appeal an opportunity of being heard, pass such order as it thinks fit, confirming, modifying or setting aside the order appealed against.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span>(4) Where an appeal is preferred against any order of the adjudicating officer under sub-section (1), such appeal shall not be entertained by the Tribunal unless such person has deposited with the Tribunal ten per cent. of the amount of the penalty imposed by the adjudicating officer.] <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/><br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
