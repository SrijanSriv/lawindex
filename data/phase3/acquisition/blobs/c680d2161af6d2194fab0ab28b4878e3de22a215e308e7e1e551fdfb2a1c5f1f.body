                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span><sup>1</sup>[ 5A. Appeal to National Green Tribunal.—Any person aggrieved by any directions issues under section 5, on or after the commencement of the National Green Tribunal Act, 2010, may file an appeal to the National Green Tribunal established under section 3 of the National Green Tribunal Act, 2010, in accordance with the provisions of that Act.]<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
