                "dc.identifier.next_section" : [ {
                  "value" : "10.Powers of entry and inspection.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
                  "value" : "10",
                  "language" : null,
