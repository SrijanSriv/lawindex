                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>No civil court shall have jurisdiction to entertain any suit or proceeding in respect of anything done, action taken or order or direction issued by the Central Government or any other authority or officer in pursuance of any power conferred by or in relation to its or his functions under this Act.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
