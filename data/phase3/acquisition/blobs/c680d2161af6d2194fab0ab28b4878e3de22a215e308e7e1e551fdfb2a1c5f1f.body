                "dc.identifier.next_section" : [ {
                  "value" : "6.Rules to regulate environmental pollution.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
                  "value" : "5",
                  "language" : null,
