                "dc.identifier.section_footnote" : [ {
                  "value" : "<sup>1</sup>. Ins. by Act 18 of 2023, s. 2 and the Schedule (w.e.f. 1-4-2024).<br/><hr style=\"border: none; margin-bottom: 3px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_id" : [ {
                  "value" : "89180",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "16A",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span><sup>1</sup><b>[16A. Accounts and audit of Fund.</b>--(1) The Central Government shall maintain separate accounts and other relevant records in relation to the Environmental Protection Fund and prepare an annual statement of accounts in such form, as may be prescribed, in consultation with the Comptroller and Auditor-General of India<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span>(2) The accounts of the Fund shall be audited by the Comptroller and Auditor-General of India at such intervals as may be specified by him and such audited accounts together with the audit report thereon shall be forwarded annually to the Central Government.] <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
