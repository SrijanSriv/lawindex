                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.page_number" : [ {
                  "value" : "5",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.page_to" : [ {
                  "value" : "0",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.repealed" : [ {
                  "value" : "false",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_id" : [ {
                  "value" : "3960",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "9",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>(1) Where the discharge of any environmental pollutant in excess of the prescribed standards occurs or is apprehended to occur due to any accident or other unforeseen act or event, the person responsible for such discharge and the person in charge of the place at which such discharge occurs or is apprehended to occur shall be bound to prevent or mitigate the environmental pollution caused as a result of such discharge and shall also forthwith--<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span><span style=\"margin-left: 15px;\"></span> (a) intimate the fact of such occurrence or apprehension of such occurrence; and<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span><span style=\"margin-left: 15px;\"></span> (b) be bound, if called upon, to render all assistance,<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> to such authorities or agencies as may be prescribed.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> (2) On receipt of information with respect to the fact or apprehension of any occurrence of the nature referred to in sub-section <i>(1)</i>, whether through intimation under that sub-section or otherwise, the authorities or agencies referred to in sub-section <i>(1)</i> shall, as early as practicable, cause such remedial measures to be taken as are necessary to prevent or mitigate the environmental pollution.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> (3) The expenses, if any, incurred by any authority or agency with respect to the remedial measures referred to in sub-section <i>(2)</i>, together with interest (at such reasonable rate as the Government may, by order, fix) from the date when a demand for the expenses is made until it is paid, may be recovered by such authority or agency from the person concerned as arrears of land revenue or of public demand. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
