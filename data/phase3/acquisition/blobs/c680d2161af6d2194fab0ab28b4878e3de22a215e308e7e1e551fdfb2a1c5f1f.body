                "dc.identifier.next_section" : [ {
                  "value" : "26.Rules made under this Act to be laid before Parliament.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
                  "value" : "36",
                  "language" : null,
