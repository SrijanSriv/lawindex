                "dc.identifier.section_footnote" : [ {
                  "value" : "<sup>1</sup> . 19th November, 1986, <i>vide</i> notification No. G.S.R. 1198(E), dated 12th November, 1986, <i>see</i> Gazette of India, Extraordinary, Part II, sec. 3<i>(i)</i>.",
