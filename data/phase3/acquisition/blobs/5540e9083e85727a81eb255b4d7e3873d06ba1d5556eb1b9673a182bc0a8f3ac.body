                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>The appropriate Government may, by notification, require that from such date, the employer in every establishment shall furnish such information or return as may be prescribed by the Central Government in relation to vacancies appointed for persons with benchmark disability that have occurred or are about to occur in that establishment to such special employment exchange as may be notified by the Central Government and the establishment shall thereupon comply with such requisition.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
