                "dc.identifier.next_section" : [ {
                  "value" : "63.Vacation of seats by Members.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
                  "value" : "62",
                  "language" : null,
