                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>The Central Advisory Board shall meet at least once in every six months and shall observe such rules of procedure in regard to the transaction of business at its meetings as may be prescribed.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
