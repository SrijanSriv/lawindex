                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.page_number" : [ {
                  "value" : "17",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.page_to" : [ {
                  "value" : "0",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.repealed" : [ {
                  "value" : "false",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_id" : [ {
                  "value" : "12099",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "38",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>(1) Any person with benchmark disability, who considers himself to be in need of high support, or any person or organisation on his or her behalf, may apply to an authority, to be notified by the appropriate Government, requesting to provide high support.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> (2) On receipt of an application under sub-section <i>(1)</i>, the authority shall refer it to an Assessment Board consisting of such Members as may be prescribed by the Central Government.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> (3) The Assessment Board shall assess the case referred to it under sub-section <i>(1)</i> in such manner as may be prescribed by the Central Government, and shall send a report to the authority certifying the need of high support and its nature.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> (4) On receipt of a report under sub-section <i>(3)</i>, the authority shall take steps to provide support in accordance with the report and subject to relevant schemes and orders of the appropriate Government in this behalf.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.state_id" : [ {
                  "value" : "1",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.state_name" : [ {
                  "value" : "CENTRAL",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
