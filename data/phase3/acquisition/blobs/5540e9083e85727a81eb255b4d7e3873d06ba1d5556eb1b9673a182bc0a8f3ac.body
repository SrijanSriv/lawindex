                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>The appropriate Government shall take measures to promote development, production and distribution of universally designed consumer products and accessories for general use for persons with disabilities.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
