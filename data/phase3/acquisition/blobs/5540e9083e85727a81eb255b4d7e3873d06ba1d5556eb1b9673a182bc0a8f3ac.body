                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>The appropriate Government shall undertake social audit of all general schemes and programmes involving the persons with disabilities to ensure that the scheme and programmes do not have an adverse impact upon the persons with disabilities and need the requirements and concerns of persons with disabilities.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
