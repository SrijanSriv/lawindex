                "dc.identifier.section_footnote" : [ {
                  "value" : "<sup>1</sup> 19th April, 2017 <i>vide</i> notification no. S.O. 1215 (E) dated 19th April, 2017 <i>see</i> Gazette of India, Extraordinary, Part II, Section 3 <i>(ii)</i>.<br/><hr style=\"border: none; margin-bottom: 3px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
