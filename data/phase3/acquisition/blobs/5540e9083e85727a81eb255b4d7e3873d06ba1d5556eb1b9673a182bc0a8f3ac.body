                "dc.identifier.section_footnote" : [ {
                  "value" : "<sup>1</sup>. Ins. by Act 4 of 2018, s. 3 and the second Schedule (w.e.f. 5-1-2018).",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_id" : [ {
                  "value" : "12137",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "76",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>Whenever the Chief Commissioner makes a recommendation to an authority in pursuance of clause (b) <sup>1</sup>[of subsection (1)] of section 75, that authority shall take necessary action on it, and inform the Chief Commissioner of the action taken within three months from the date of receipt of the recommendation:<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> Provided that where an authority does not accept a recommendation, it shall convey reasons for nonacceptance to the Chief Commissioner within a period of three months, and shall also inform the aggrieved person.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
