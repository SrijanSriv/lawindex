                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>The appropriate Government and the local authorities shall take measures to promote, protect and ensure participation of persons with disabilities in adult education and continuing education programmes equally with others. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
