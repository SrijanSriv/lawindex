                "dc.identifier.section_number" : [ {
                  "value" : "85",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>(1) For every Special Court, the State Government may, by notification, specify a Public Prosecutor or appoint an advocate, who has been in practice as an advocate for not less than seven years, as a Special Public Prosecutor for the purpose of conducting cases in that Court.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> (2) The Special Public Prosecutor appointed under sub-section <i>(1)</i> shall be entitled to receive such fees or remuneration as may be prescribed by the State Government.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
