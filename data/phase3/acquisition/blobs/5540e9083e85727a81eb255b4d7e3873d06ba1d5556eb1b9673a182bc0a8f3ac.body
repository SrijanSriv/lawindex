                "dc.identifier.section_number" : [ {
                  "value" : "40",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>The Central Government shall, in consultation with the Chief Commissioner, formulate rules for persons with disabilities laying down the standards of accessibility for the physical environment, transportation, information and communications, including appropriate technologies and systems, and other facilities and services provided to the public in urban and rural areas.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
