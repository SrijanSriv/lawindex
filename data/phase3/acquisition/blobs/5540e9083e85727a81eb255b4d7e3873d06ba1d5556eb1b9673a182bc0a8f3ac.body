                "dc.identifier.next_section" : [ {
                  "value" : "52.Revocation of registration.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
