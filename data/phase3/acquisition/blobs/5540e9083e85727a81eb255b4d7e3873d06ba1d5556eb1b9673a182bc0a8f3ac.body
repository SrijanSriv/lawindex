                "dc.identifier.next_section" : [ {
                  "value" : "31.Free education for children with benchmark disabilities.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
