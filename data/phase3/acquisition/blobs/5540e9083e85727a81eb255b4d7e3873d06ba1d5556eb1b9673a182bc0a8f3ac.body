                "dc.identifier.next_section" : [ {
                  "value" : "38.Special provisions for persons with disabilities with high support.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
