                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>No Court shall take cognizance of an offence alleged to have been committed by an employee of the appropriate Government under this Chapter, except with the previous sanction of the appropriate Government or a complaint is filed by an officer authorised by it in this behalf.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
