                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>No act or proceeding of the Central Advisory Board on disability, a State Advisory Board on disability, or a District-level Committee on disability shall be called in question on the ground merely of the existence of any vacancy in or any defect in the constitution of such Board or Committee, as the case may be.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
