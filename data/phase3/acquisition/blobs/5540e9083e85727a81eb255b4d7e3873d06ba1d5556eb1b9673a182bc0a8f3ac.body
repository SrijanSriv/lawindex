                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>The appropriate Government shall initiate or cause to be initiated research and development through individuals and institutions on issues which shall enhance habilitation and rehabilitation and on such other issues which are necessary for the empowerment of persons with disabilities. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
