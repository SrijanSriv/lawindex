                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>Whoever, fraudulently avails or attempts to avail any benefit meant for persons with benchmark disabilities, shall be punishable with imprisonment for a term which may extend to two years or with fine which may extend to one lakh rupees or with both.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
