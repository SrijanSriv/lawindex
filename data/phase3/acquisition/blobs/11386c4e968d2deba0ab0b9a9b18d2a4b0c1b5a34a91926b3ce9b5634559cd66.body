                } ],
                "dc.identifier.ministry_name" : [ {
                  "value" : "Ministry of Electronics and Information Technology",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
                  "value" : "15",
                  "language" : null,
