                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_footnote" : [ {
                  "value" : "<b><sup>*1</sup>. 13th November, 2025</b>--- Ss. 2, 18 to 26, 35 to 43 and sub-section (1) and (3) of s. 44;<br/><hr style=\"border: none; margin-bottom: 3px; margin-top: 0;\"/> One year from 13th November, 2025--- Sub-section (9) of s. 6 and clause (d) of sub-section (1) of s. 27;<br/><hr style=\"border: none; margin-bottom: 3px; margin-top: 0;\"/> Eighteen Months from 13th November, 2025--- Ss. 3 to 5, sub-sections (1) to (8) and (10) of s. 6, ss. 7 to 17, s. 27 except clause (d) of sub-section (1) of the said sections, ss. 28 to 34, 36, 37 and sub-section (2) of s. 44, <i>vide</i> notifn. No. G.S.R. 843(E), dated 13th November, 2025, <i>see</i> Gazette of India, Extraordinary, Part II, s. 3(i).<br/><hr style=\"border: none; margin-bottom: 3px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_id" : [ {
                  "value" : "101267",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "1",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>(1) This Act may be called the Digital Personal Data Protection Act, 2023.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span>(2) It shall come into force on such date<sup>1</sup> as the Central Government may, by notification in the Official Gazette, appoint and <sup>*</sup>different dates may be appointed for different provisions of this Act and any reference in any such provision to the commencement of this Act shall be construed as a reference to the coming into force of that provision.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.state_id" : [ {
                  "value" : "1",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
