                } ],
                "dc.identifier.notification_no" : [ {
                  "value" : "1st April, 2010, vide notification No. S.O. 428(E), dated 16th February, 2010, see Gazette of India, Extraordinary, Part II, sec. 3(ii).",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.preamble_description" : [ {
                  "value" : "<center style=\"font-size: 17px;\">THE RIGHT OF CHILDREN TO FREE AND COMPULSORY EDUCATION ACT, 2009</center> <center style=\"font-size: 16px;\">ACT NO. 35 OF 2009</center> <p style=\"text-align:right;\">[26th August, 2009.]</p> An Act to provide for free and compulsory education to all children of the age of six to fourteen years.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span>BE it enacted by Parliament in the Sixtieth Year of the Republic of India as follows:--",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
