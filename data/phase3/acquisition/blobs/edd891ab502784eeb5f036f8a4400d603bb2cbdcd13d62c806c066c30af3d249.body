                "dc.identifier.no_of_section" : [ {
                  "value" : "0",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.notification_no" : [ {
                  "value" : "1st April, 2010, vide notification No. S.O. 428(E), dated 16th February, 2010, see Gazette of India, Extraordinary, Part II, sec. 3(ii).",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.preamble_description" : [ {
                  "value" : "The preamble of the Right of Children to Free and Compulsory Education (RTE) Act, 2009 states, \"An Act to provide for free and compulsory education to all children of the age of six to fourteen years\". The act was passed in 2009 to give effect to Article 21A of the Constitution of India, which was amended in 2002 to make education a fundamental right for children between the ages of 6 and 14. The act also ensures that children receive a certificate after completing elementary education.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.preamble_footnote" : [ {
                  "value" : "The preamble of the Right of Children to Free and Compulsory Education Act, 2009 states, \"An Act to provide for free and compulsory education to all children of the age of six to fourteen years\". The act also states that the state will try to provide early childhood care and education for children until they are six years old.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.preamble_title" : [ {
                  "value" : "The Right of Children to Free and Compulsory Education (RTE) Act, 2009",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
