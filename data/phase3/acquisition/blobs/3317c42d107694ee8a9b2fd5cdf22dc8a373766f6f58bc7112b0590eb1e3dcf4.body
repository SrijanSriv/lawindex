                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>Whoever fails to comply with any provision of this Act for which no separate penalty has been provided in this Act shall be punished with imprisonment for a term which may extend to one year, or with fine or with both.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
