                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.page_number" : [ {
                  "value" : "17",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.page_to" : [ {
                  "value" : "0",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.repealed" : [ {
                  "value" : "false",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_id" : [ {
                  "value" : "7425",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "26",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>(1) The Central Government, may, having regard to the value of article or currency or security, their vulnerability to theft or any relevant consideration, by notification, specify such article or currency or security which shall, as soon as may be after their seizure, be disposed of by such officer and in such manner, as the Central Government may, from time to time, determine after following the procedure hereinafter specified.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> (2) The article or currency or security seized shall be forwarded without unnecessary delay to such officer as may be specified.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> (3) Where any article or currency or security has been seized and forwarded to such officer, the officer referred to in sub-section <i>(1)</i>, shall prepare an inventory of such article or currency or security containing such details relating to their description, value or such other identifying particulars as the officer referred to in that sub-section may consider relevant to the identity of the article or the currency or security and make an application to any Magistrate for the purposes of certifying the correctness of the inventory so prepared.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> (4) Where an application is made under sub-section <i>(2)</i>, the Magistrate shall, as soon as may be, allow the application.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> (5) Notwithstanding anything contained in the Indian Evidence Act, 1872 (1 of 1872) or the Code of Criminal Procedure, 1973 (2 of 1974), every court trying an offence under this Act, shall treat the inventory, as certified by the Magistrate, as primary evidence in respect of such offence.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> (6) Every officer acting under sub-section <i>(3)</i> shall forthwith report the seizure to the Court of Session or Assistant Sessions Judge having jurisdiction for adjudging the confiscation under section 29.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.state_id" : [ {
                  "value" : "1",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
