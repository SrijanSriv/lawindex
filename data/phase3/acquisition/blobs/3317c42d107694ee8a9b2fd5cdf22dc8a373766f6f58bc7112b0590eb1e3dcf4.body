                "dc.identifier.next_section" : [ {
                  "value" : "17.Foreign contribution through scheduled bank.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
                  "value" : "18",
                  "language" : null,
