                "dc.identifier.next_section" : [ {
                  "value" : "7.Prohibition to transfer foreign contribution to other person.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
                  "value" : "6",
                  "language" : null,
