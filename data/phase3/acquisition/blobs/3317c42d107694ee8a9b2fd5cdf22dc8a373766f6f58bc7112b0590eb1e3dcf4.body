                "dc.identifier.next_section" : [ {
                  "value" : "12.Grant of certificate of registration.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
                  "value" : "11",
                  "language" : null,
