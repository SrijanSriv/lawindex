                "dc.identifier.section_id" : [ {
                  "value" : "7429",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "30",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>No order of adjudication of confiscation shall be made unless a reasonable opportunity of making a representation against such confiscation has been given to the person from whom any article or currency or security has been seized.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
