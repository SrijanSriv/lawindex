                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "33",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>Any person, subject to this Act, who knowingly,—<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span><span style=\"margin-left: 15px;\"></span> (a) gives false intimation under clause <i>(c)</i> of section 9 or section 18; or<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span><span style=\"margin-left: 15px;\"></span> (b) seeks prior permission or registration by means of fraud, false representation or concealment of material fact,<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> shall, on conviction by a court, be liable to imprisonment for a term which may extend to six months or with fine or with both.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
