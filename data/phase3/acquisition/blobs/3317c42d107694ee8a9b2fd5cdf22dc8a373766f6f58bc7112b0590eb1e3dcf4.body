                  "place" : 0
                } ],
                "dc.identifier.page_number" : [ {
                  "value" : "14",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.page_to" : [ {
                  "value" : "0",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.repealed" : [ {
                  "value" : "false",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_footnote" : [ {
                  "value" : "<sup>1</sup>. The proviso ins. by s. 11, <i>ibid</i>. (w.e.f 29-9-2020).<br/><hr style=\"border: none; margin-bottom: 3px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_id" : [ {
                  "value" : "7415",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "16",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>(1) Every person who has been granted a certificate under section 12 shall have such certificate renewed within six months before the expiry of the period of the certificate.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <sup>1</sup>[Provided that the Central Government may, before renewing the certificate, make such inquiry, as it deems fit, to satisfy itself that such person has fulfilled all conditions specified in sub-section (4) of section 12.]<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> (2) The application for renewal of the certificate shall be made to the Central Government in such form and manner and accompanied by such fee as may be prescribed.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> (3) The Central Government shall renew the certificate, ordinarily within ninety days from the date of receipt of application for renewal of certificate subject to such terms and conditions as it may deem fit and grant a certificate of renewal for a period of five years:<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> Provided that in case the Central Government does not renew the certificate within the said period of ninety days, it shall communicate the reasons therefor to the applicant:<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> Provided further that the Central Government may refuse to renew the certificate in case where a person has violated any of the provisions of this Act or rules made thereunder.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.state_id" : [ {
                  "value" : "1",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.state_name" : [ {
                  "value" : "CENTRAL",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
