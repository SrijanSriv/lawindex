                "dc.identifier.next_section" : [ {
                  "value" : "32.Revision of orders by Central Government.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
                  "value" : "33",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.page_from" : [ {
                  "value" : "0",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.page_number" : [ {
                  "value" : "18",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.page_to" : [ {
                  "value" : "0",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.repealed" : [ {
                  "value" : "false",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_id" : [ {
                  "value" : "7430",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "31",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>(1) Any person aggrieved by any order made under section 29 may prefer an appeal,--<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span><span style=\"margin-left: 15px;\"></span> (a) where the order has been made by the Court of Session, to the High Court to which such Court is subordinate; or<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span><span style=\"margin-left: 15px;\"></span> (b) where the order has been made by any officer specified under clause <i>(b)</i> of sub-section <i>(1)</i> of section 29, to the Court of Session within the local limits of whose jurisdiction such order of adjudication of confiscation was made,<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> within one month from the date of communication to such person of the order:<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> Provided that the appellate court may, if it is satisfied that the appellant was prevented by sufficient cause from preferring the appeal within the said period of one month, allow such appeal to be preferred within a further period of one month, but not thereafter.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> (2) Any organisation referred to in clause <i>(f)</i> of sub-section <i>(1)</i> of section 3, or any person or association referred to in section 6 or section 9, aggrieved by an order made in pursuance of section 5 or by an order of the Central Government refusing to give permission under this Act, or by any order made by the Central Government under sub-section <i>(2)</i> or sub-section <i>(4)</i> of section 12, or sub-section <i>(1)</i> of section 14, as the case may be, may, within sixty days from the date of such order, prefer an appeal against such order to the High Court within the local limits of whose jurisdiction the appellant ordinarily resides or carries on business or personally works for gain, or, where the appellant is an organisation or association, the principal office of such organisation or association is located.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> (3) Every appeal preferred under this section shall be deemed to be an appeal from an original decree and the provisions of Order XLI of the First Schedule to the Code of Civil Procedure, 1908 (5 of 1908), shall, as far as may be, apply thereto as they apply to an appeal from an original decree.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.state_id" : [ {
                  "value" : "1",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
