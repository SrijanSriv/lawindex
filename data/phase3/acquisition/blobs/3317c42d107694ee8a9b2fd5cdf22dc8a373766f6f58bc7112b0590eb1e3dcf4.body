                "dc.identifier.next_section" : [ {
                  "value" : "27.Seizure to be made in accordance with Act 2 of 1974.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
