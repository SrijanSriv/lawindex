                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>No suit or other legal proceedings shall lie against the Central Government or the authority referred to in section 44 or any of its officers in respect of any loss or damage caused or likely to be caused by anything which is in good faith done or intended to be done in pursuance of the provisions of this Act or, any rule or order made thereunder. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
