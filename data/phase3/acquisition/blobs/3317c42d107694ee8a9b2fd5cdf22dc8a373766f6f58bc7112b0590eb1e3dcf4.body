                "dc.identifier.next_section" : [ {
                  "value" : "15.Management of foreign contribution of person whose certificate has been cancelled.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
