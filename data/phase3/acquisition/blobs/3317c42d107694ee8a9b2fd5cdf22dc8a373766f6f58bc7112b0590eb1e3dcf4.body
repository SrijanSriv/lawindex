                "dc.identifier.next_section" : [ {
                  "value" : "37.Penalty for offences where no separate punishment has been provided.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
                  "value" : "38",
                  "language" : null,
