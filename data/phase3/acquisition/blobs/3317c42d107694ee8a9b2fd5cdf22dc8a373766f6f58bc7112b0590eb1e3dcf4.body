                "dc.identifier.next_section" : [ {
                  "value" : "49.Orders and rules to be laid before Parliament.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
                  "value" : "50",
                  "language" : null,
