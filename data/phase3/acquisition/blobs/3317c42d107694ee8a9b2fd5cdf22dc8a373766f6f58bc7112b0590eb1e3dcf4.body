                "dc.identifier.page_to" : [ {
                  "value" : "0",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.repealed" : [ {
                  "value" : "false",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_id" : [ {
                  "value" : "7417",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "18",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>(1) Every person who has been granted a certificate or given prior approval under this Act shall give, within such time and in such manner as may be prescribed, an intimation to the Central Government, and such other authority as may be specified by the Central Government, as to the amount of each foreign contribution received by it, the source from which and the manner in which such foreign contribution was received, and the purposes for which, and the manner in which such foreign contribution was utilised by him.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> (2) Every person receiving foreign contribution shall submit a copy of a statement indicating therein the particulars of foreign contribution received duly certified by officer of the bank or authorised person in foreign exchange and furnish the same to the Central Government along with the intimation under sub-section <i>(1)</i>.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
