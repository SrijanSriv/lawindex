                  "value" : "When contracts become void which are contingent on happening of specified event within fixed time . When contracts may be enforced, which are contingent on specified event not happening within fixed time.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ]
              },
