                  "place" : 0
                } ],
                "dc.identifier.page_number" : [ {
                  "value" : "12",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.page_to" : [ {
                  "value" : "0",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.repealed" : [ {
                  "value" : "false",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_id" : [ {
                  "value" : "38615",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "12",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>A person is said to be of sound mind for the purpose of making a contract, if, at the time when he makes it, he is capable of understanding it and of forming a rational judgment as to its effect upon his interests.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span>A person who is usually of unsound mind, but occasionally of sound mind, may make a contract when he is of sound mind.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span>A person who is usually of sound mind, but occasionally of unsound mind, may not make a contract when he is of unsound mind.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <i>Illustrations</i><br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span>(a) A patient in a lunatic asylum, who is at intervals of sound mind, may contract during those intervals.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span>(b) A sane man, who is delirious from fever or who is so drunk that he cannot understand the terms of a contract, or form a rational judgment as to its effect on his interests, cannot contract whilst such delirium or drunkenness lasts.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.state_id" : [ {
                  "value" : "1",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
