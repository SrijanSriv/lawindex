                "dc.identifier.section_footnote" : [ {
                  "value" : "1. 15th day of March, 2026, <i>vide</i> notifn. No. S.O. 1244(E), dated 10th day of March, 2026, <i>see</i> Gazette of India, Extraordinary, Part II, sec. 3 (<i>ii</i>).<br/><hr style=\"border: none; margin-bottom: 3px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_id" : [ {
                  "value" : "106023",
