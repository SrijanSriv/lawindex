                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>Every ship owner shall provide and maintain such accommodations and recreational facilities for seafarers working or living onboard, or both, consistent with promoting the seafarer’s health and well-being, as may be prescribed. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
