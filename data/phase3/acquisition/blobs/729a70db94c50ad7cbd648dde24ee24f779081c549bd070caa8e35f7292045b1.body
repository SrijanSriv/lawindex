                "dc.identifier.section_id" : [ {
                  "value" : "106060",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "38",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>No owner or master of an Indian vessel shall knowingly do anything or permit anything to be done, or carry or permit to be carried any papers or documents, with intent to conceal the Indian character of the vessel from any person entitled by any law for the time being in force to inquire into the same, or with intent to assume a foreign character for the vessel, or with intent to deceive any person so entitled. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
