                  "place" : 0
                } ],
                "dc.identifier.section_id" : [ {
                  "value" : "106090",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "68",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>In case of loss or foundering of any vessel, the ship owner shall pay to each seafarer onboard such indemnity against unemployment resulting from such loss or foundering, as may be prescribed. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
