                "dc.identifier.section_number" : [ {
                  "value" : "29",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>A registered mortgage of a vessel or share shall not be affected by any act of insolvency committed by the mortgagor after the date of the record of such mortgage, notwithstanding that the mortgagor, at the commencement of his insolvency, had the vessel or share in his possession, order or disposition, or was the reputed owner thereof, and the mortgage shall be preferred to any right, claim or interest therein of the other creditors of the insolvent or any trustee or assignee on their behalf.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.state_id" : [ {
                  "value" : "1",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
