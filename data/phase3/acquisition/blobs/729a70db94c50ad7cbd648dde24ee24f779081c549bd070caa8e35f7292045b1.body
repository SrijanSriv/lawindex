                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>It shall be the duty of the ship owner to take such measures for providing protection of health and medical care, at no cost to seafarers employed onboard the vessel, as may be prescribed.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
