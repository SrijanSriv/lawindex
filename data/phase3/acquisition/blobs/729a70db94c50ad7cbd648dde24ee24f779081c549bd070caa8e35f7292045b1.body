                  "place" : 0
                } ],
                "dc.identifier.page_number" : [ {
                  "value" : "26",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.page_to" : [ {
                  "value" : "0",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.repealed" : [ {
                  "value" : "false",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_id" : [ {
                  "value" : "106059",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "37",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>(1) The Central Government may, by notification, declare the proper national colours for all Indian vessels and for all vessels owned by the Government and different colours may be declared for different classes of vessels.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span>(2) Vessels registered under this Part shall hoist the proper national colours,---<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span><span style=\"margin-left: 15px;\"></span>(a) on a signal being made to her by any vessel of the Indian Navy or Indian Coast Guard;<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span><span style=\"margin-left: 15px;\"></span>(b) on entering or leaving any port.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span>(3) Any commissioned officer of the Indian Navy or an officer of the Indian Coast Guard or a surveyor or an Indian ambassador may board any vessel on which any colours are hoisted contrary to this Act and seize and take away the colours which shall be forfeited to the Government.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span>(4) No person on board a vessel which is not an Indian vessel shall, for the purpose of making it appear to be an Indian vessel, use the Indian national colours, unless the assumption of Indian character has been made for the purpose of escaping capture by the enemy or by a foreign vessel of war in the exercise of some belligerent right.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
