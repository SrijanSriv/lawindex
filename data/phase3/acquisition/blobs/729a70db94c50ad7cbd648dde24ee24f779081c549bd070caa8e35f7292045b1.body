                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>Where, by reason of the transmission of any property in a vessel or a share therein on death, insolvency or otherwise, a vessel ceases to be an Indian vessel, it may be ordered to be sold in such manner as may be prescribed.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
