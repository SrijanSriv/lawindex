                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>Where a seafarer is missing or lost with the vessel to which he belongs, the Central Government or such officer as the Central Government may appoint in this behalf may recover the wages and the compensation due to him from the master or ship owner or his agent in the same court and in the same manner in which the seafarer's wages are recoverable, and shall deal with those wages in the same manner as with the wages and compensation due to other deceased seafarers under this Act. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.state_id" : [ {
                  "value" : "1",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.state_name" : [ {
                  "value" : "CENTRAL",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.uri" : [ {
                  "value" : "http://test1.indiacode.nic.in/handle/123456789/512870",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.title" : [ {
                  "value" : "Recovery of wages, etc., of seafarers lost with vessel.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ]
              },
