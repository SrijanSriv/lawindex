                "dc.identifier.ministry_id" : [ {
                  "value" : "198",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.ministry_name" : [ {
                  "value" : "Ministry of Ports, Shipping and Waterways",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
