                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>Every ship owner shall ensure that every seafarer in his employment is given such hours of rest as may be prescribed.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
