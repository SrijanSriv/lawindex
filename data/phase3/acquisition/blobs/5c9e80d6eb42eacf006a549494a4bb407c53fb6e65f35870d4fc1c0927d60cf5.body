                "dc.identifier.section_number" : [ {
                  "value" : "75",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span><b>75. Orders for payment of money passed by Registrar of Copyrights and <sup>1</sup>[Appellate Board] to be executable as a decree.--</b>Every order made by the Registrar of Copyrights or the <sup>1</sup>[Appellate Board] under this Act for the payment of any money or by the High Court in any appeal against any such order of the <sup>1</sup>[Appellate Board] shall, on a certificate issued by the Registrar of Copyrights, the <sup>1</sup>[Appellate Board] or the Registrar of the High Court, as the case may be, be deemed to be a decree of a civil court and shall be executable in the same manner as a decree of such court.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
