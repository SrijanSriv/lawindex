                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>The termination of the authority of an agent causes the termination (subject to the rules herein contained regarding the termination of an agent's authority) of the authority of all sub-agents appointed by him.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
