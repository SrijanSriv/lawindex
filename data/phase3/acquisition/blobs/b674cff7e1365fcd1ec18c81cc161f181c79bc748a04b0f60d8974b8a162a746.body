                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>Reasonable notice must be given of such revocation or renunciation, otherwise the damage thereby resulting to the principal or the agent, as the case may be, must be made good to the one by the other.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
