                  "place" : 0
                } ],
                "dc.title" : [ {
                  "value" : "Consequence of inducing agent or principal to act on belief that principal or agent will be held exclusively liable.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
