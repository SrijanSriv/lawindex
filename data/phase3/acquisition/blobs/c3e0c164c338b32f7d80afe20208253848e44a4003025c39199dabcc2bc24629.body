                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>In respect of any sum paid by a public authority in India or by the Fund as compensation for pollution damage, that authority or the Fund shall acquire by subrogation any rights which the person so compensated would have enjoyed under the Fund Convention. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
