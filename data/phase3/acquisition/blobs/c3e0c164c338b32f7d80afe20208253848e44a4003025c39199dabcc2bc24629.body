                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.page_to" : [ {
                  "value" : "0",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.repealed" : [ {
                  "value" : "false",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_id" : [ {
                  "value" : "106312",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "290",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>(1) Where under this Act a vessel is authorised or ordered to be detained, any commissioned officer of the Indian Navy or Indian Coast Guard or any port officer, police, pilot, harbour master, conservator of port or customs commissioner may detain the vessel under instructions of the proper officer.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span>(2) If any vessel after detention or after service on the master for any notice of, or order for, such detention proceeds to sea before she is released by any competent authority, the master of the vessel shall be guilty of an offence under this Act.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span>(3) When a vessel so proceeding to sea takes to sea any person authorised under this Act to detain or survey the vessel, the owner, master or agent of such vessel shall each be liable to pay all expenses of, and incidental to, such person being so taken to sea and shall also be guilty of an offence under this Act.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span>(4) When any owner or master or agent is convicted of an offence under sub-section (<i>3</i>), the court making the order of conviction may inquire and determine the amount payable on account of expenses by such owner, master or agent and may direct that the same shall be recovered from him in the manner provided for the recovery of fines.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.state_id" : [ {
                  "value" : "1",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
