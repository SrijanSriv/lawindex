                  "place" : 0
                } ],
                "dc.identifier.repealed" : [ {
                  "value" : "false",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_id" : [ {
                  "value" : "106301",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "279",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>(1) Notwithstanding anything contained in this Part, the Central Government may, by order in writing and upon such conditions, if any, as it may think fit to impose, exempt any vessel or tindal, skipper or member of crew of such vessel or any class thereof, from any specified requirement contained in or prescribed in pursuance of this Act or dispense with the observance of any such requirement in the case of any vessel or tindal, skipper or member of crew of such vessel or any class thereof, if it is satisfied that the requirement is substantially complied with or that compliance with the requirement is or ought to be dispensed with in the circumstances of the case.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span>(2) Where an exemption is granted under sub-section (<i>1</i>) subject to any condition, a breach of any such condition shall, without prejudice to any other remedy, be liable to penalty under this Act. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.state_id" : [ {
                  "value" : "1",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
