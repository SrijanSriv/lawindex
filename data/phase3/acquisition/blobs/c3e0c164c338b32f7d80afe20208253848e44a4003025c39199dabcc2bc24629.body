                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.page_number" : [ {
                  "value" : "114",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.page_to" : [ {
                  "value" : "0",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.repealed" : [ {
                  "value" : "false",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_id" : [ {
                  "value" : "106313",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "291",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>(1) When an order under this Act for the payment of any wages or other sums of money is made by any court or other officer or authority and the money is not paid at the time or in the manner directed, the sum mentioned in the order with such further sum as may be thereby awarded for costs, may be levied by distress and sale of the movable property of the person directed to pay the same under a warrant to be issued for that purpose by such court.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span>(2) Where any court or other officer or authority has power under this Act to make an order directing payment to be made of any seafarer’s wages, fines or other sums of money, then, if the person so directed to pay the same is the master, owner or agent of a vessel and the same is not paid at the time or in the manner directed by such court or other officer or authority, the court or officer or authority may, in addition to any other power which it may have for the purpose of compelling payment by warrant, direct the amount remaining unpaid to be levied by distress and sale of the vessel and her equipment.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.state_id" : [ {
                  "value" : "1",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
