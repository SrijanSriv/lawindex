                  "place" : 0
                } ],
                "dc.identifier.page_to" : [ {
                  "value" : "0",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.repealed" : [ {
                  "value" : "false",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_id" : [ {
                  "value" : "106299",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "277",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>(1) Any vessel attempting to ply or proceed to sea without free board markings or any vessel which is so loaded as to submerge such markings or carrying persons in excess of the certified capacity may be detained by a proper officer until the vessel complies with the requirements of this Act. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span>(2) Save as otherwise provided, for the purposes of this Part, a proper officer may, at any reasonable time, go onboard a vessel and may inspect or audit the vessel and any part thereof, the structure, equipment, fittings, arrangements, materials, systems, scantlings, cargo, provisions, stores, her certificates and certificates of the crew onboard:<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span>Provided that the proper officer shall not unreasonably hinder the operation of the vessel or unreasonably detain or delay her from proceeding on any voyage.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span>(3) The owner, agent, master or every officer of the vessel shall afford to the proper officer all reasonable facilities for a survey or audit and provide all such information in respect of the vessel and her structure, equipment, fittings, arrangements, materials, scantlings, systems, cargo, provisions, stores, her certificates, and certificates of the crew, as the proper officer may reasonably require. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.state_id" : [ {
                  "value" : "1",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.state_name" : [ {
                  "value" : "CENTRAL",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
