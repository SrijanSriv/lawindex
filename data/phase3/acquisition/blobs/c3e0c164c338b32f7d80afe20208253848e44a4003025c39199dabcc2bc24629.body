                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>Where this Act requires that the provisions or arrangements for a vessel shall meet the obligations under the convention, or otherwise, the Central Government may, after satisfying itself by trials or based on the convention or its protocol or its amendments or otherwise, that any such provision or arrangement is as effective as that so required, by order, direct or permit such other provisions or arrangements to be used or provided.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
