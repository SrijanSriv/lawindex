                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.title" : [ {
                  "value" : "Power to detain foreign vessel that has occasioned damage.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
