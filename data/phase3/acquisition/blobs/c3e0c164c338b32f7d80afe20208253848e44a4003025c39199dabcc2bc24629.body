                  "place" : 0
                } ],
                "dc.identifier.section_id" : [ {
                  "value" : "106233",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "211",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>This Chapter shall apply to pollution damage caused in the territory of India, including the coastal waters, not extending more than two hundred nautical miles from the baseline and to preventive measures, wherever taken, to prevent or minimise such pollution damage. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
