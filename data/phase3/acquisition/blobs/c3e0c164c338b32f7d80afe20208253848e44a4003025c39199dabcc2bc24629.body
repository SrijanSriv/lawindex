                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "214",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>(1) The contributions payable to the Fund by a person for any year shall be, ---<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span><span style=\"margin-left: 15px;\"></span>(a) such amount as may be determined under Article 12 of the Fund Convention;<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span><span style=\"margin-left: 15px;\"></span>(b) in such instalments, becoming due at such dates,<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> as may be notified under the Fund Convention and any amount due shall be payable along with interest at a rate determined under Article 13 of the Fund Convention.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span>(2) The Central Government may require persons who are or may be liable to pay contributions to the Fund under this Chapter to give financial security for payment of contributions to the Central Government or the Fund.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.state_id" : [ {
                  "value" : "1",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.state_name" : [ {
                  "value" : "CENTRAL",
                  "language" : null,
