                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>Nothing contained in this Chapter shall prejudice the right of recourse that the ship owner may have against any other person in respect of his liability. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
