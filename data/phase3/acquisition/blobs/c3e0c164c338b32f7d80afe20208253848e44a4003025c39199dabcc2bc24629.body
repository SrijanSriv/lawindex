                } ],
                "dc.identifier.repealed" : [ {
                  "value" : "false",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_id" : [ {
                  "value" : "106300",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "278",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>(1) If any vessel under this Part arrives in or proceeds from a port or place in India in an unseaworthy condition or which is likely to pose a threat to the security on Indian coasts or offshore installations, the vessel may be detained until the owner, master or tindal or skipper takes all reasonable measures to ensure the seaworthiness of the vessel.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span>(2) Nothing contained in sub-section (<i>1</i>) shall affect the liability of the person in charge of the vessel in respect of such unseaworthiness or threat to the security on Indian coasts or offshore installations under any other provisions of this Act.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
