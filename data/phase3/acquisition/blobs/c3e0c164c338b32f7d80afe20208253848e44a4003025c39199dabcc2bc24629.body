                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>The Central Government may establish a fund for the pollution damage exceeding the amount payable under this Part and the source of fund and manner of disbursement of compensation from such fund shall be such as may be prescribed.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
