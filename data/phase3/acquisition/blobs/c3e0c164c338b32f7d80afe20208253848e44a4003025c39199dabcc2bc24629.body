                  "place" : 0
                } ],
                "dc.identifier.page_to" : [ {
                  "value" : "0",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.repealed" : [ {
                  "value" : "false",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_id" : [ {
                  "value" : "106258",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "236",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>(1) When any Indian vessel or any ship other than an Indian vessel, is involved in a maritime casualty resulting in a wreck in any area to which this Chapter applies, the master or ship owner or the operator of the ship shall, without any delay report such incident to the Director-General and the Maritime Rescue Coordination Centre or the Maritime Rescue Sub-Centre of Indian Coast Guard.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span>(2) When any Indian vessel is involved in a maritime casualty resulting in a wreck in a convention area of any State, the master and the operator of that ship shall, without any delay, report such incident to the affected State in such manner as may be required by that State and shall also report such incident to the Director-General and the Maritime Rescue Coordination Centre or the Maritime Rescue Sub-Centre of Indian Coast Guard.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span><i>Explanation.</i>---For the purposes of this sub-section,---<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span><span style=\"margin-left: 15px;\"></span>(i) &quot;affected State&quot; means the country in whose convention area the wreck is located;<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span><span style=\"margin-left: 15px;\"></span>(ii) &quot;convention area&quot; means the Exclusive Economic Zone of a State party established in accordance with international law or, if a State party has not established such a zone, an area beyond and adjacent to the territorial sea of that State determined by that State in accordance with international law and extending not more than two hundred nautical miles from the baseline from which the breadth of its territorial sea is measured. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.state_id" : [ {
                  "value" : "1",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.state_name" : [ {
                  "value" : "CENTRAL",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
