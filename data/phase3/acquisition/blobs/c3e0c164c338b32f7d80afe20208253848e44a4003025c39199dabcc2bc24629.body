                "dc.identifier.section_number" : [ {
                  "value" : "229",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>Every registered owner of an Indian vessel or any other vessels which enter a port, shipyard or offshore terminal or place in India or within coastal waters shall, for the purpose of covering his liability under this Part, maintain adequate insurance coverage or such other financial security as may be prescribed, and carry onboard a certificate or document showing compliance with such requirement. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
