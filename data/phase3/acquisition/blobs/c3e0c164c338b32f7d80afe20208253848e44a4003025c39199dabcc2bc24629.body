                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>The Central Government may, by notification, direct that the provisions of this Act or any of them shall not apply to vessels belonging to the Government of any State or to any class of such vessels.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
