                "dc.identifier.page_to" : [ {
                  "value" : "0",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.repealed" : [ {
                  "value" : "false",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_id" : [ {
                  "value" : "38704",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "148",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>A \"bailment\" is the delivery of goods by one person to another for some purpose, upon a contract that they shall, when the purpose is accomplished, be returned or otherwise disposed of according to the directions of the person delivering them. The person delivering the goods is called the \"bailor\". The person to whom they are delivered is called, the \"bailee\".<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> <i>Explanation</i>.—If a person already in possession of the goods of another contracts to hold them as a bailee, he thereby becomes the bailee, and the owner becomes the bailor of such goods, although they may not have been delivered by way of bailment<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.state_id" : [ {
                  "value" : "1",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.state_name" : [ {
                  "value" : "CENTRAL",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.uri" : [ {
                  "value" : "http://test1.indiacode.nic.in/handle/123456789/531471",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.title" : [ {
                  "value" : "\"Bailment\", \"bailor\" and \"bailee\" defined.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ]
              },
