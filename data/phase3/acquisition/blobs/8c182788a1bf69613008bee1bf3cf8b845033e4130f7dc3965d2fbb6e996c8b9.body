                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>No valid ratification can be made by a person whose knowledge of the facts of the case is materially defective.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
