                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>If a person, other than the bailor, claims goods bailed he may apply to the Court to stop the delivery of the goods to the bailor, and to decide the title to the goods.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
