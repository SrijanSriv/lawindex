                "dc.identifier.preamble_description" : [ {
                  "value" : "<center style=\"font-size: 17px;\"> THE CONSUMER PROTECTION ACT, 2019</center> <center style=\"font-size: 16px;\">ACT NO. 35 OF 2019</center> <p style=\"text-align:right;\">[<i>9th August, 2019.</i>]</p> An Act to provide for protection of the interests of consumers and for the said purpose, to establish authorities for timely and effective administration and settlement of consumers' disputes and for matters connected therewith or incidentalthereto.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span>BE it enacted by Parliament in the Seventieth Year of the Republic of India as follows:---<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
