                "dc.identifier.next_section" : [ {
                  "value" : "110.Power to call for information.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
                  "value" : "109",
                  "language" : null,
