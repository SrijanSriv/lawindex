                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>No suit, prosecution or other legal proceeding shall lie against the appropriate Government or against the chairperson or any other member of the Authority or the Board, as the case may be, for anything which is in good faith done or intended to be done in pursuance of this Act or any rule or regulation made thereunder in the discharge of official duties. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
