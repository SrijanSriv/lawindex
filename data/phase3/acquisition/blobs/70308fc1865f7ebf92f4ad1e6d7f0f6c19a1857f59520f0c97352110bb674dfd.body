                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>No mental health professional or medical practitioner shall discharge any duty or perform any function not authorised by this Act or specify or recommend any medicine or treatment not authorised by the field of his profession. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
