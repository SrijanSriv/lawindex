                "dc.identifier.next_section" : [ {
                  "value" : "113.Power of State Government to supersede State Authority",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
