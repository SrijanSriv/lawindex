                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>For the purposes of conferring jurisdiction on any court in relation to an offence under this Code or the rules, regulation or bye-laws made there under in connection with an establishment, the place where the establishment is for the time being situated, shall be deemed to be the place where such offence has been committed.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
