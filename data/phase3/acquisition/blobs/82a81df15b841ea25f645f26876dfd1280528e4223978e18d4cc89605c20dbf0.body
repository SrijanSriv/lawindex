                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>Whoever in compliance of the provisions of section 67, fails to appoint a manager shall be punishable with imprisonment for a term which may extend to three months, or with fine which may extend to one lakh rupees, or with both.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
