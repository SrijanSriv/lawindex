                "dc.identifier.section_number" : [ {
                  "value" : "101",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>Whoever, except in so far as it may be necessary for the purposes of a prosecution for any offence punishable under this Code, publishes or discloses to any person the results of an analysis, of a sample of substance used or intended to be used in any process under this Code, shall be punishable with imprisonment for a term, which may extend to six months, or with fine, which may extend to fifty thousand rupees, or with both.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
