                } ],
                "dc.identifier.ministry_name" : [ {
                  "value" : "Ministry of Labour and Employment",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
                  "value" : "121",
                  "language" : null,
