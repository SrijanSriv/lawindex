        }, {
          "hitHighlights" : null,
          "type" : "discover",
          "_links" : {
            "indexableObject" : {
              "href" : "https://indiacode.gov.in/server/api/core/items/d41fe391-b9c0-40b1-afdc-ad034c7ac62f"
            }
          },
          "_embedded" : {
            "indexableObject" : {
              "id" : "d41fe391-b9c0-40b1-afdc-ad034c7ac62f",
              "uuid" : "d41fe391-b9c0-40b1-afdc-ad034c7ac62f",
              "name" : "The Information Technology Act, 2000",
              "handle" : "123456789/496511",
              "metadata" : {
                "dc.date.accessioned" : [ {
                  "value" : "2026-07-10T20:12:19Z",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.date.act_year" : [ {
                  "value" : "2000",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.date.enact_date" : [ {
                  "value" : "2000-06-09",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.date.enforcement_date" : [ {
                  "value" : "17-10-2000",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.date.issued" : [ {
                  "value" : "2000-06-09",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.date.last_modified" : [ {
                  "value" : "2020-04-06",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.description.abstract" : [ {
                  "value" : "Summary of the Information Technology Act, 2000\n Key Provisions  \n1.\tDigital Signatures & Electronic Records\n•\tSections 3, 3A, 4, 5: Authentication of electronic records, electronic signatures, and their legal recognition.\n2.\tElectronic Governance\n•\tSections 6, 7, 8: Use of electronic records and signatures in Government.\n3.\tOffences and Penalties (Broadly Relevant)\n•\tSections 65-77B: Various cyber offences with penalties (e.g., tampering, identity theft, cyber terrorism).\n•\tSection 69A: Power to Block Public Access to Information - Relevant in preventing the dissemination of terrorist content or communications.\n•\tSection 69B: Power to Monitor and Collect Traffic Data - Useful for surveillance on suspected terrorist communications, balancing national security with privacy concerns.\n•\tSection 84: Protection of Action Taken in Good Faith - Applies to actions taken against non-State actors/terrorists in the cyber domain.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.act_id" : [ {
                  "value" : "AC_CEN_45_76_00001_200021_1517807324077",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.act_number" : [ {
                  "value" : "21",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.collection" : [ {
                  "value" : "ACT",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.givenid" : [ {
                  "value" : "200021",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.ministry_id" : [ {
                  "value" : "45",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.ministry_name" : [ {
                  "value" : "Ministry of Electronics and Information Technology",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.notification_no" : [ {
                  "value" : "17th October, 2000, vide notification No. G.S.R. 788 (E), dated 17th October, 2000, see Gazette of India, Extraordinary, Part II, sec. 3(ii).",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.preamble_description" : [ {
                  "value" : "<center style=\"font-size: 17px;\">THE INFORMATION TECHNOLOGY ACT, 2000</center> <center style=\"font-size: 16px;\">ACT NO. 21 OF 2000</center> <p style=\"text-align:right;\">[9th June, 2000.]</p> An Act to provide legal recognition for transactions carried out by means of electronic data interchange and other means of electronic communication, commonly referred to as \"electronic commerce‖\", which involve the use of alternatives to paper-based methods of communication and storage of information, to facilitate electronic filing of documents with the Government agencies and further to amend the Indian Penal Code, the Indian Evidence Act, 1872, the Banker’s Books Evidence Act, 1891 and the Reserve Bank of India Act, 1934 and for matters connected therewith or incidental thereto.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span>WHEREAS the General Assembly of the United Nations by resolution A/RES/51/162, dated the 30th January, 1997 has adopted the Model Law on Electronic Commerce adopted by the United Nations Commission on International Trade Law;<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span>AND WHEREAS the said resolution recommends <i>inter alia</i>, that all States give favourable consideration to the said Model Law when they enact or revise their laws, in view of the need for uniformity of the law applicable to alternatives to paper-based methods of communication and storage of information;<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span>AND WHEREAS it is considered necessary to give effect to the said resolution and to promote efficient delivery of Government services by means of reliable electronic records.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span>BE it enacted by Parliament in the Fifty-first Year of the Republic of India as follows:--",
                  "language" : null,
