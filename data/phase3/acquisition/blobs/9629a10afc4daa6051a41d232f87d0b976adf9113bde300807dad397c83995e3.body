                } ],
                "dc.legislation.history" : [ {
                  "value" : "<p>Legislative Summary: </p><p>The Information Technology Act, 2000</p><p> </p><p>Act Title - The Information Technology Act, 2000</p><p>Act Number - Act No. 21 of 2000</p><p>Enactment Date - June 9, 2000</p><p>Enforcement Date - October 17, 2000 (vide G.S.R. 788(E))</p><p>Ministry - Ministry of Electronics and Information Technology (MeitY)</p><p></p><p>Core Statutory Objectives</p><p></p><p>•\tLegal Recognition for E-Commerce: Provides statutory validity to transactions executed via Electronic Data Interchange (EDI) and other paperless electronic communication methods. </p><p>•\tE-Governance Support: Facilitates electronic filing of documents, digital issuance of licenses/permits, and secure retention of records with Government departments. </p><p>•\tCybercrime &amp; Data Protection: Establishes a legal mechanism to penalize unauthorized access, data theft, cyber crimes, and online fraud. </p><p>•\tConsequential Amendments: Amends the Indian Penal Code (1860), the Indian Evidence Act (1872), the Bankers&#39; Books Evidence Act (1891), and the Reserve Bank of India Act (1934) to accommodate electronic evidence.</p><p> </p><p>Source: India Code (Ministry of Electronics and Information Technology - MeitY, Government of India)</p><p></p><p></p><p></p>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.title" : [ {
                  "value" : "The Information Technology Act, 2000",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
