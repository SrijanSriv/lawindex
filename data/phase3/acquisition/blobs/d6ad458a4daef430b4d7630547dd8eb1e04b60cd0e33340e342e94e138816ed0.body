                "dc.identifier.page_to" : [ {
                  "value" : "0",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.repealed" : [ {
                  "value" : "false",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_id" : [ {
                  "value" : "106150",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "128",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>(1) In every contract of service, express or implied, between the owner of a vessel and the master or any seafarer thereof, there shall be implied, irrespective of any agreement to the contrary, an obligation on the ship owner that such ship owner and the master and every agent charged with the loading of such vessel or the preparing thereof for sea or the sending thereof to sea, shall use all reasonable means to ensure the seaworthiness of such vessel for the voyage at the time when such voyage commences and to keep her in a seaworthy state during the voyage.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span>(2) For the purpose of verifying compliance of the provisions of this section, the Central Government may, either at the request of the ship owner or otherwise, arrange for a survey of the hull, equipment or machinery of any sea-going vessel by a surveyor or any person so authorised.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.state_id" : [ {
                  "value" : "1",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.state_name" : [ {
                  "value" : "CENTRAL",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.uri" : [ {
                  "value" : "http://test1.indiacode.nic.in/handle/123456789/512908",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
