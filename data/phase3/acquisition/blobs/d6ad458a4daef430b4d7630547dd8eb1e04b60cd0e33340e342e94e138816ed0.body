                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_id" : [ {
                  "value" : "106124",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
