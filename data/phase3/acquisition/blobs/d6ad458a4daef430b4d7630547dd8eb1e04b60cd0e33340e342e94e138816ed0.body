                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "178",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>When an incident involving two or more ships occur and pollution damage results therefrom, all the ship owners concerned, unless exonerated under sub-section (<i>3</i>) of section 177, shall be jointly and severally liable for all such damage which is not reasonably separable<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
