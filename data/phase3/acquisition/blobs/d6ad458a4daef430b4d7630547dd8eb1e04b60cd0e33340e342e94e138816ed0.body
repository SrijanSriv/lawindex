                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "102",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>Whenever any seafarer engaged outside India on an Indian vessel deserts or otherwise absents himself in India without leave, the master of the vessel shall, within forty-eight hours of discovering such desertion or absence, report the same to the shipping master or to such other officer as the Central Government specifies in this behalf, unless in the meantime, the deserter or absentee returns. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
