                "dc.identifier.section_id" : [ {
                  "value" : "106137",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "115",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>In this part, unless the context otherwise requires,---<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span><span style=\"margin-left: 15px;\"></span>(a) &quot;company&quot; means the owner of the vessel or any other organisation or person such as the manager, or the bareboat charterer, who has assumed the responsibility for operation of the vessel from the owner of the vessel and who on assuming such responsibility has agreed to take over all the duties and responsibilities imposed by the International Safety Management Code under the Safety Convention;<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span><span style=\"margin-left: 15px;\"></span>(b) the words and expressions used in this Part but not defined, shall have the meanings respectively assigned to them in the international conventions or agreements or treaties, including their protocols, referred to in section 116.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
