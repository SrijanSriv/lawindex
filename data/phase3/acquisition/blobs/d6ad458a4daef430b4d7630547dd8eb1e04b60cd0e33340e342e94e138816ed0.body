                } ],
                "dc.identifier.ministry_name" : [ {
                  "value" : "Ministry of Ports, Shipping and Waterways",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
                  "value" : "142",
                  "language" : null,
