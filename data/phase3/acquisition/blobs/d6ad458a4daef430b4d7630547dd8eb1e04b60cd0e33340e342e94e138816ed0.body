                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_id" : [ {
                  "value" : "106211",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "189",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>Any certificate granted by a competent authority in a State outside India to a ship registered in that State or any certificate granted by a competent authority of a State which is a contracting party to the Civil Liability Convention to any ship wherever it is registered, shall be accepted at any port or place in India, as if it were granted under this Act.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
