                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "163",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>A person shall not be entitled to limit his liability under section 162, if it is proved that the loss resulted from his personal act or omission, committed with the intent to cause such loss, or committed recklessly and with knowledge that such loss is likely to resul<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
