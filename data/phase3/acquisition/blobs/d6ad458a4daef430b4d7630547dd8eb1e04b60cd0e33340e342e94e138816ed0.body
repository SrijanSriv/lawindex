                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>The Central Government shall, whenever necessary, make arrangements for search and rescue services for dealing with distress situation at sea, including coastal waters or such territory under the International Convention on Maritime Search and Rescue, 1979 and agreement related thereto or any other law for the time being in force.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
