                "dc.identifier.section_number" : [ {
                  "value" : "164",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>Where a person entitled to limitation of liability under this Chapter has a claim against the claimant arising out of the same occurrence, their respective claims shall be set off against each other and the provisions of this Chapter shall apply only to the balance, if any.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
