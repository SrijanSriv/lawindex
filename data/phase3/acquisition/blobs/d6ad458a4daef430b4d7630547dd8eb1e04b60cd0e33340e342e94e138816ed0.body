                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>No person shall secrete himself and go to sea in a vessel without the consent of either the master or the ship owner or his agent or of the person in charge of the vessel or of any other person entitled to give that consent<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
