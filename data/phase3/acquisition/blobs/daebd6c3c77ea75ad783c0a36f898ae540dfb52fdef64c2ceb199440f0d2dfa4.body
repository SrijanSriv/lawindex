                "dc.identifier.next_section" : [ {
                  "value" : "9.Duties of local authority.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
                  "value" : "8",
                  "language" : null,
