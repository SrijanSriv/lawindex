                "dc.identifier.next_section" : [ {
                  "value" : "6.Duty of appropriate Government and local authority to establish school.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
                  "value" : "5",
                  "language" : null,
