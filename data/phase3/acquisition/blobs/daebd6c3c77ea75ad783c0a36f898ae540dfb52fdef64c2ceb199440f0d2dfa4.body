                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>The appointing authority, in relation to a school established, owned, controlled or substantially financed by funds provided directly or indirectly by the appropriate Government or by a local authority, shall ensure that vacancy of teacher in a school under its control shall not exceed ten per cent/of the total sanctioned strength.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
