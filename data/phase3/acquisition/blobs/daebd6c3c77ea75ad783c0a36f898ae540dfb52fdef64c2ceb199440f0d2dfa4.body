                "dc.identifier.repealed" : [ {
                  "value" : "false",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_footnote" : [ {
                  "value" : "<sup>1</sup> Subs. by Act 30 of 2012, s. 7, for \"Within six months\" (w.e.f. 1-8-2012).",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_id" : [ {
                  "value" : "9032",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "25",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>(1) <sup>1</sup>[Within three years] from the date of commencement of this Act, the appropriate Government and the local authority shall ensure that the Pupil-Teacher Ratio, as specified in the Schedule, is maintained in each school.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> (2) For the purpose of maintaining the Pupil-Teacher Ratio under sub-section (1), no teacher posted in a school shall be made to serve in any other school or office or deployed for any non-educational purpose, other than those specified in section 27.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
