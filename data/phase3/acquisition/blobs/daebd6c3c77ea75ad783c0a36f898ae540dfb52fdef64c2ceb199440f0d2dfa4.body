                "dc.identifier.next_section" : [ {
                  "value" : "39.Power of Central Government to remove difficulties.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
                  "value" : "38",
                  "language" : null,
