                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>(1) The Persons with Disabilities (Equal Opportunity Protection of Rights and Full Participation) Act, 1995 (1 of 1996) is hereby repealed.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> (2) Notwithstanding the repeal of the said Act, anything done or any action taken under the said Act, shall be deemed to have been done or taken under the corresponding provisions of this Act.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
