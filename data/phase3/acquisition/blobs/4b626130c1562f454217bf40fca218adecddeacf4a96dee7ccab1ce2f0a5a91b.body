                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>No suit or other legal proceeding shall lie against any person for anything which is in good faith done or intended to be done under this Act.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
