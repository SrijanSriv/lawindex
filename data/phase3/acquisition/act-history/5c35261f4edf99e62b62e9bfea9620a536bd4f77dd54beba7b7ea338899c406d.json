      "dc.identifier.preamble_description": [
        {
          "value": "<center style=\"font-size: 17px;\">THE REPEALING AND AMENDING ACT, 2023</center> <center style=\"font-size: 16px;\">ACT NO. 37 OF 2023</center> <p style=\"text-align:right;\">[17th December, 2023.]</p> An Act to repeal certain enactments and to amend an enactment.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> BE it enacted by Parliament in the Seventy-fourth Year of the Republic of India as follows:--<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
